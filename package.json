{
    "name": "sc-instrument-helper",
    "version": "1.0.1-beta.0",
    "description": "SC Intrumentation Helpers",
    "main": "./lib/index.js",
    "typings": "./lib/index.d.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "reg": "npm set registry https://npm.lumigame.com",
        "pub": "npm publish --registry https://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry https://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "files": [
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-instrument-helper.git"
    },
    "keywords": [
        "otel",
        "instrumentation",
        "helpers"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "ISC",
    "dependencies": {
        "socket.io": "4.6.1",
        "socket.io-msgpack-parser": "3.0.2",
        "mongoose": "8.4.1"
    },
    "devDependencies": {
        "@babel/preset-env": "7.12.11",
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "9.1.2",
        "@opentelemetry/api": "1.1.0",
        "@semantic-release/changelog": "5.0.1",
        "@semantic-release/commit-analyzer": "8.0.1",
        "@semantic-release/git": "9.0.0",
        "@semantic-release/gitlab": "6.0.4",
        "@semantic-release/npm": "7.0.5",
        "@semantic-release/release-notes-generator": "9.0.1",
        "husky": "4.2.5",
        "install": "0.13.0",
        "rimraf": "3.0.2",
        "sc-semantic-release": "1.2.0",
        "semantic-release": "17.1.1",
        "typescript": "4.6.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
